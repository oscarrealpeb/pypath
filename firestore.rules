rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@pypath.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
        );
    }

    function validUserIdentity(userId) {
      return request.resource.data.id == userId;
    }

    function validEmailVerifiedUpdate() {
      return request.resource.data.emailVerified == request.auth.token.email_verified ||
        request.resource.data.emailVerified == resource.data.emailVerified;
    }

    function userProfileAfter(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId));
    }

    function validNicknameIndexWrite(nicknameNormalized, userId) {
      let nextProfile = userProfileAfter(userId).data;
      return request.resource.data.userId == userId &&
        request.resource.data.nicknameNormalized == nicknameNormalized &&
        request.resource.data.nickname is string &&
        request.resource.data.email == nextProfile.email &&
        request.resource.data.emailNormalized == nextProfile.email &&
        request.resource.data.nickname == nextProfile.nickname &&
        nextProfile.nicknameNormalized == nicknameNormalized;
    }

    function validEmailIndexWrite(emailNormalized, userId) {
      let nextProfile = userProfileAfter(userId).data;
      return request.resource.data.userId == userId &&
        request.resource.data.email == nextProfile.email &&
        request.resource.data.emailNormalized == emailNormalized &&
        nextProfile.email == emailNormalized;
    }

    function validDisplayNameIndexWrite(nameNormalized, userId) {
      let nextProfile = userProfileAfter(userId).data;
      return request.resource.data.userId == userId &&
        request.resource.data.nameNormalized == nameNormalized &&
        request.resource.data.name is string &&
        request.resource.data.email == nextProfile.email &&
        request.resource.data.emailNormalized == nextProfile.email &&
        request.resource.data.name == nextProfile.name &&
        nextProfile.nameNormalized == nameNormalized;
    }

    function ownerCanCreateUser(userId) {
      return isOwner(userId) &&
        validUserIdentity(userId) &&
        request.resource.data.systemRole == (isBootstrapAdmin() ? 'admin' : 'student') &&
        request.resource.data.status == 'active' &&
        (
          request.resource.data.emailVerified == false ||
          request.resource.data.emailVerified == request.auth.token.email_verified
        );
    }

    function ownerCanUpdateUser(userId) {
      return isOwner(userId) &&
        validUserIdentity(userId) &&
        request.resource.data.systemRole == resource.data.systemRole &&
        request.resource.data.status == resource.data.status &&
        validEmailVerifiedUpdate();
    }

    function isOwnActivityRecord() {
      return isSignedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          resource.data.targetUserId == request.auth.uid
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || ownerCanCreateUser(userId);
      allow update: if isAdmin() || ownerCanUpdateUser(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /nicknameIndex/{nicknameNormalized} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isAdmin() ||
        (
          isSignedIn() &&
          validNicknameIndexWrite(nicknameNormalized, request.auth.uid)
        );
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          validNicknameIndexWrite(nicknameNormalized, request.auth.uid)
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /emailIndex/{emailNormalized} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin() ||
        (
          isSignedIn() &&
          validEmailIndexWrite(emailNormalized, request.auth.uid)
        );
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          validEmailIndexWrite(emailNormalized, request.auth.uid)
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /displayNameIndex/{nameNormalized} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() ||
        (
          isSignedIn() &&
          validDisplayNameIndexWrite(nameNormalized, request.auth.uid)
        );
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          validDisplayNameIndexWrite(nameNormalized, request.auth.uid)
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /platform/content-cms {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platformActivity/{eventId} {
      allow get, list: if isAdmin() || isOwnActivityRecord();
      allow create: if isSignedIn() &&
        request.resource.data.id == eventId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.type is string &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.keys().hasAll(['id', 'type', 'timestamp', 'userId']) &&
        request.resource.data.keys().hasOnly([
          'id',
          'type',
          'timestamp',
          'userId',
          'targetUserId',
          'courseId',
          'unitId',
          'lessonId',
          'assessmentId',
          'recommendedCourseId',
          'status',
          'systemRole',
          'provider',
          'actor',
        ]) &&
        (
          request.resource.data.actor == null ||
          (
            request.resource.data.actor.id == request.auth.uid &&
            request.resource.data.actor.email == request.auth.token.email
          )
        );
      allow update: if false;
      allow delete: if isAdmin() || isOwnActivityRecord();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
