rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@pypath.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
        );
    }

    function validUserIdentity(userId) {
      return request.resource.data.id == userId;
    }

    function validEmailVerifiedUpdate() {
      return request.resource.data.emailVerified == request.auth.token.email_verified ||
        request.resource.data.emailVerified == resource.data.emailVerified;
    }

    function ownerCanCreateUser(userId) {
      return isOwner(userId) &&
        validUserIdentity(userId) &&
        request.resource.data.systemRole == (isBootstrapAdmin() ? 'admin' : 'student') &&
        request.resource.data.status == 'active' &&
        (
          request.resource.data.emailVerified == false ||
          request.resource.data.emailVerified == request.auth.token.email_verified
        );
    }

    function ownerCanUpdateUser(userId) {
      return isOwner(userId) &&
        validUserIdentity(userId) &&
        request.resource.data.systemRole == resource.data.systemRole &&
        request.resource.data.status == resource.data.status &&
        validEmailVerifiedUpdate();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || ownerCanCreateUser(userId);
      allow update: if isAdmin() || ownerCanUpdateUser(userId);
      allow delete: if isAdmin();
    }

    match /nicknameIndex/{nicknameNormalized} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /emailIndex/{emailNormalized} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /displayNameIndex/{nameNormalized} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        );
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /platform/content-cms {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
